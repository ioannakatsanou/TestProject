# ── PostgreSQL ───────────────────────────────────────────────────────────
# Local (Docker) default. In production use your managed Postgres URL.
# Managed providers often require SSL: append ?sslmode=require
DATABASE_URL=postgresql://agfb:agfb@localhost:5432/agfb

# ── Claude / Anthropic ───────────────────────────────────────────────────
# If left EMPTY, the backend runs in MOCK mode and builds a deterministic
# answer from the data — the prototype works fully without a key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (NO trailing slash).
# Local dev default below. In production set this to your Vercel URL, e.g.:
#   ALLOWED_ORIGINS=https://ask-greece-for-business.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ── Tuning ───────────────────────────────────────────────────────────────
# How many decisions to feed Claude as context per question
MAX_CONTEXT_DECISIONS=12
