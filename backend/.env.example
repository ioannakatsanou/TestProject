# PostgreSQL connection string
DATABASE_URL=postgresql://agfb:agfb@localhost:5432/agfb

# Anthropic / Claude API.
# If left empty, the backend runs in MOCK mode and builds a deterministic
# answer from the retrieved seed data — the prototype still works end-to-end.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# CORS: the frontend origin (Next.js dev server by default)
ALLOWED_ORIGIN=http://localhost:3000

# How many decisions to feed Claude as context per question
MAX_CONTEXT_DECISIONS=12
